    <file src="..\Source\TK.CustomMap\bin\AppVeyor\netstandard2.0\TK.CustomMap.dll" target="lib\MonoAndroid10" />
    <file src="..\Source\TK.CustomMap\bin\AppVeyor\netstandard2.0\TK.CustomMap.xml" target="lib\MonoAndroid10" />

    <!--Xamarin.iOS Unified-->
    <file src="..\Source\TK.CustomMap.iOSUnified\bin\AppVeyor\TK.CustomMap.iOSUnified.dll" target="lib\Xamarin.iOS10" />
