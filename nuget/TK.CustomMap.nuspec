<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata minClientVersion="2.8.3">
    <id>TK.CustomMap</id>
    <version>3.0.0</version>
    <title>Rich and bindable Map control for Xamarin.Forms</title>
    <authors>Iratrips</authors>
    <owners>Iratrips</owners>
    <licenseUrl>https://github.com/iratrips-india/IratripsMapKit/blob/Development/License.md</licenseUrl>
    <projectUrl>https://github.com/iratrips-india/IratripsMapKit.git</projectUrl>
    <!--<iconUrl>https://www.nuget.org/Content/Images/packageDefaultIcon.png</iconUrl>-->
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      Iratrips.Mapkit lets you customize pins, add overlays, calculate routes, search place predictions, cluster pins and more! 
    </description>
    <summary>Rich and bindable Map control for Xamarin.Forms</summary>
    <tags>xamarin, map, xamarin.forms, xamarin.forms.maps, extended map, custom map</tags>
    <dependencies>
      <group targetFramework="netstandard2.1">
        <dependency id="NETStandard.Library" version="2.1.0" />
        <dependency id="Xamarin.Forms" version="5.0.0.2515" />
        <dependency id="Newtonsoft.Json" version="13.0.1" />
      </group>
      <group targetFramework="MonoAndroid12">
        <dependency id="Xamarin.GooglePlayServices.Places" version="117.0.0.7" />
        <dependency id="Xamarin.Google.Maps.Utils" version="1.0.3" />
        <dependency id="Xamarin.Forms" version="5.0.0.2515" />
        <dependency id="Newtonsoft.Json" version="13.0.1" />
      </group>
      <group targetFramework="Xamarin.iOS10">
        <dependency id="Xamarin.iOS.ClusterKit" version="0.3.1.1" />
        <dependency id="Xamarin.Forms" version="5.0.0.2515" />
        <dependency id="Newtonsoft.Json" version="13.0.1" />
      </group>
      <!--<group targetFramework="uap10.0">
        <dependency id="Xamarin.Forms" version="2.4.0.282" />
      </group>-->
    </dependencies>
  </metadata>
  <files>
