    <file src="..\Source\TK.CustomMap\bin\AppVeyor\netstandard2.0\TK.CustomMap.dll" target="lib\netstandard2.0" />
    <file src="..\Source\TK.CustomMap\bin\AppVeyor\netstandard2.0\TK.CustomMap.xml" target="lib\netstandard2.0" />

    <!--Xamarin.Android-->
